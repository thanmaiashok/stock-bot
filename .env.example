# Neo4j (auto-configured by docker-compose — change only if self-hosting)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=stockbot123

# SQLite database path
DATABASE_PATH=./data/stockbot.db

# Paper wallet starting balance (USD)
PAPER_WALLET_USD=10000

# Reddit API (free — create at https://www.reddit.com/prefs/apps, type: script)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=StockBot/1.0 by your_reddit_username
